# Copy to .env and fill in. Get the values from:
#   Supabase dashboard -> Project -> Settings -> API
#
# This project's Supabase ref is: lfkelavgvkscggyijeze
#
# TWO KINDS OF KEY, and the difference matters more than anything else in this file.
#
#   PUBLISHABLE (sb_publishable_...) is PUBLIC by design. It is compiled into the browser
#   bundle and ships to every visitor. Row-level security, not secrecy, protects the data
#   behind it. Safe here, safe in a build arg.
#
#   SERVICE ROLE bypasses row-level security completely — it is the master key to this
#   project. It is read at RUN time only (src/integrations/supabase/client.server.ts).
#   Never put it in a build arg: build args are recorded in image history and travel with
#   the image into any registry.

SUPABASE_PROJECT_ID="lfkelavgvkscggyijeze"
SUPABASE_URL="https://lfkelavgvkscggyijeze.supabase.co"
SUPABASE_PUBLISHABLE_KEY=""

# Vite inlines anything prefixed VITE_ into the CLIENT bundle at BUILD time. Changing one
# of these needs a rebuild, not a restart.
VITE_SUPABASE_PROJECT_ID="lfkelavgvkscggyijeze"
VITE_SUPABASE_URL="https://lfkelavgvkscggyijeze.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Server-side only. Never prefixed VITE_, never a build arg.
SUPABASE_SERVICE_ROLE_KEY=""

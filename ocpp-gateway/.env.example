# UZA Charge Network — OCPP gateway process
# Copy to .env and fill in. No secret ever lives in source.

# Port the chargers connect to
OCPP_GATEWAY_PORT=9220
# Path prefix: chargers connect to ws://host/ocpp/<ChargePointIdentity>
OCPP_GATEWAY_PATH=/ocpp

# UZA Charge API (central system). Required — the gateway has no database access.
UZA_API_BASE_URL=https://uza-charge-east.lovable.app
UZA_API_TIMEOUT_MS=10000
UZA_API_RETRIES=2

# Optional shared secret sent as x-gateway-token on every central-system call
OCPP_GATEWAY_TOKEN=

# Keepalive and command delivery
OCPP_GATEWAY_PING_MS=30000
OCPP_GATEWAY_COMMAND_POLL_MS=5000
